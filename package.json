{
  "name": "@loke/logger",
  "version": "4.0.0",
  "description": "Logger module for LOKE applications. Supports syslog and console output.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "test": "npm run build && ava -v --timeout=30s 'dist/**/*.test.js' dist/test.js",
    "posttest": "npm run lint",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "build": "rm -rf ./dist && tsc"
  },
  "keywords": [
    "logger"
  ],
  "author": "LOKE Engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOKE/loke-logger.git"
  },
  "bugs": {
    "url": "https://github.com/LOKE/loke-logger/issues"
  },
  "homepage": "https://github.com/LOKE/loke-logger#readme",
  "dependencies": {
    "glossy": "^0.1.7"
  },
  "peerDependencies": {
    "prom-client": ">=12 <=15"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "ava": "^8.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ava": "^14.0.0",
    "prettier": "^3.3.3",
    "prom-client": "^15.1.3",
    "typescript": "^5.6.2"
  }
}
